# Salin file ini menjadi .env atau .env.local, lalu isi dengan nilai milik Anda.
# Jangan pernah commit file .env / .env.local ke repository.

# PostgreSQL lokal atau cloud (misalnya Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret acak minimal 32 karakter untuk NextAuth.
# Contoh membuatnya di PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
NEXTAUTH_SECRET="ganti-dengan-secret-acak-anda"

# URL aplikasi saat dijalankan secara lokal.
NEXTAUTH_URL="http://localhost:3000"
